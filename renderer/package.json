    "animate.css": "^4.1.1",
    "apexcharts": "^6.6.1",
    "dot-prop": "9.x.x",
    "fast-deep-equal": "^3.1.3",
    "fastest-levenshtein": "^1.0.16",
    "luxon": "3.x.x",
    "neverthrow": "^8.0.0",
    "object-hash": "^3.0.0",
    "sockette": "^2.0.6",
    "tailwindcss": "3.x.x",
    "tippy.js": "^6.2.7",
    "vue": "3.5.40",
